# Публичный список переменных МАВИТА-ШОП.
# Скопировать в .env и заполнить. Реальные .env и секреты НЕ коммитятся (I7).

# --- Next.js / App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# Если не задан — data-слой работает на seed-данных (без БД).
DATABASE_URL=postgresql://mavita:<password>@localhost:5432/mavita

# --- Robokassa (Ф3) ---
# Подпись считается только на сервере (I1). Пароли — только здесь, не в коде.
# ВАЖНО: при ROBOKASSA_TEST_MODE=true кладите сюда ТЕСТОВЫЕ Password1/Password2
# из ЛК Робокассы (они отличаются от боевых), иначе result вернёт «Bad signature».
# ROBOKASSA_LOGIN=<merchant login>
# ROBOKASSA_PASSWORD1=<password1 — формирование подписи при создании платежа>
# ROBOKASSA_PASSWORD2=<password2 — верификация result URL>
# ROBOKASSA_TEST_MODE=true
# Временно разрешает IsTest=1 на production. Только при явном решении владельца
# до запуска реальных продаж; перед боевым запуском удалить эту переменную.
# ALLOW_ROBOKASSA_TEST_MODE_IN_PRODUCTION=true
# Алгоритм подписи — ДОЛЖЕН совпадать с «Хэш-алгоритмом» в ЛК Робокассы (TD-20).
# По умолчанию md5 (дефолт Робокассы). Для перехода на SHA-256 выставить sha256
# ЗДЕСЬ и в ЛК ОДНОВРЕМЕННО, иначе result вернёт «Bad signature».
# Допустимо: md5 | sha1 | sha256 | sha384 | sha512
# ROBOKASSA_HASH_ALGO=md5
# Allowlist IP колбэка /result (TD-19, defense-in-depth к подписи). CIDR/IP через
# запятую; актуальный список — из ЛК/поддержки Робокассы. Пусто = проверка выключена.
# Требует, чтобы Nginx пробрасывал X-Forwarded-For / X-Real-IP (стандартный proxy-конфиг).
# ROBOKASSA_RESULT_IPS=1.2.3.4,185.59.216.0/22

# --- Admin (Ф4) ---
# ADMIN_PASSWORD=<пароль для входа в /admin>
# SESSION_SECRET=<32+ случайных символа для iron-session>

# --- Telegram order notifications ---
# 32 случайных байта в base64. Ключ шифрует токен Telegram-бота в PostgreSQL.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TELEGRAM_SETTINGS_ENCRYPTION_KEY=

# --- CDEK pickup points (Ф4) ---
# Доставка СДЭК. Пока заявка в СДЭК не одобрена — выставить DELIVERY_ENABLED=false:
# checkout оформляет заказ без ПВЗ (delivery_kopecks=0, total=товары), проверяется
# только оплата. После подключения СДЭК убрать эту строку (доставка станет
# обязательной) и заполнить CDEK_CLIENT_ID/SECRET ниже.
DELIVERY_ENABLED=false
# OAuth-учётные данные СДЭК: используются только сервером для поиска ПВЗ
# и повторной проверки выбранного ПВЗ перед созданием заказа.
# CDEK_CLIENT_ID=<client id>
# CDEK_CLIENT_SECRET=<client secret>
# CDEK_API_BASE=https://api.cdek.ru/v2
