# Публичный список переменных МАВИТА-ШОП.
# Скопировать в .env и заполнить. Реальные .env и секреты НЕ коммитятся (I7).

# --- Next.js / App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# Если не задан — data-слой работает на seed-данных (без БД).
DATABASE_URL=postgresql://mavita:<password>@localhost:5432/mavita

# --- Robokassa (Ф3) ---
# Подпись считается только на сервере (I1). Пароли — только здесь, не в коде.
# ВАЖНО: при ROBOKASSA_TEST_MODE=true кладите сюда ТЕСТОВЫЕ Password1/Password2
# из ЛК Робокассы (они отличаются от боевых), иначе result вернёт «Bad signature».
# ROBOKASSA_LOGIN=<merchant login>
# ROBOKASSA_PASSWORD1=<password1 — формирование подписи при создании платежа>
# ROBOKASSA_PASSWORD2=<password2 — верификация result URL>
# ROBOKASSA_TEST_MODE=true
# Временно разрешает IsTest=1 на production. Только при явном решении владельца
# до запуска реальных продаж; перед боевым запуском удалить эту переменную.
# ALLOW_ROBOKASSA_TEST_MODE_IN_PRODUCTION=true
# Алгоритм подписи — ДОЛЖЕН совпадать с «Хэш-алгоритмом» в ЛК Робокассы (TD-20).
# По умолчанию md5 (дефолт Робокассы). Для перехода на SHA-256 выставить sha256
# ЗДЕСЬ и в ЛК ОДНОВРЕМЕННО. Иначе подпись расходится: Робокасса отвергнет уже
# редирект на страницу оплаты («Ошибка проверки подписи»), и result вернёт «Bad signature».
# На production (ЛК на SHA-256) обязателен ROBOKASSA_HASH_ALGO=sha256.
# Допустимо: md5 | sha1 | sha256 | sha384 | sha512
# ROBOKASSA_HASH_ALGO=md5
# Allowlist IP колбэка /result (TD-19, defense-in-depth к подписи). CIDR/IP через
# запятую; актуальный список — из ЛК/поддержки Робокассы. Пусто = проверка выключена.
# Требует, чтобы Nginx пробрасывал X-Forwarded-For / X-Real-IP (стандартный proxy-конфиг).
# ROBOKASSA_RESULT_IPS=1.2.3.4,185.59.216.0/22

# --- Admin (Ф4) ---
# ADMIN_PASSWORD=<пароль для входа в /admin>
# SESSION_SECRET=<32+ случайных символа для iron-session>

# --- Telegram order notifications ---
# 32 случайных байта в base64. Ключ шифрует токен Telegram-бота в PostgreSQL.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TELEGRAM_SETTINGS_ENCRYPTION_KEY=
# Egress-прокси для api.telegram.org (нужен, если Telegram заблокирован с хоста, как
# на РФ-VPS). HTTP CONNECT-прокси; sendMessage идёт через него, URL остаётся
# api.telegram.org, токен внутри сквозного TLS (прокси его не видит). Пусто = напрямую.
# TELEGRAM_HTTPS_PROXY=http://<proxy-host>:8888

# --- Delivery carrier (СДЭК) ---
# Аварийный глобальный выключатель доставки. DELIVERY_ENABLED=false → checkout
# оформляет заказ без ПВЗ (delivery_kopecks=0, total=товары), проверяется только
# оплата. Перебивает любые настройки перевозчиков. Когда доставка готова — убрать
# эту строку (доставка станет обязательной при ≥1 валидно настроенном перевозчике).
DELIVERY_ENABLED=false
# Мастер-ключ шифрования секретов перевозчиков (Client ID / Client Secret) в БД.
# Декодированная длина — РОВНО 32 байта: 64 hex-символа или base64. Без него
# управление ключами доставки недоступно (перевозчики считаются нерабочими → 503).
# ПОТЕРЯ КЛЮЧА = ПОТЕРЯ ВСЕХ КЛЮЧЕЙ ПЕРЕВОЗЧИКОВ. Хранить бэкап отдельно от БД.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETTINGS_ENC_KEY=
# Базовый URL API перевозчика (секреты — в зашифрованных настройках, не здесь).
# CDEK_API_BASE=https://api.cdek.ru/v2
# Локальная база MaxMind GeoLite2-City для префилла города по IP на чекауте.
# Без неё город просто не подставляется (автокомплит работает) — фича опциональна.
# GEOIP_DB_PATH=/var/www/mavita-repo/shop/data/GeoLite2-City.mmdb
# Клиентский ключ Яндекс.Карт для виджета СДЭК. Инлайнится в бандл на сборке —
# задать ДО `npm run build`. Нет ключа → чекаут падает на ручной автокомплит
# города. Ключ ограничить доменом mavita.ru в кабинете Яндекса.
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
