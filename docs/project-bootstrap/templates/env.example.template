# Переименовать в `.env.example` при появлении первой реальной env-переменной в коде.
# До этого не создавать пустой .env.example — он создаёт ложное ощущение готовности.
#
# Этот файл — единственный публичный список переменных.
# Реальные .env-файлы никогда не коммитятся.
# Реальные секреты сюда не вносятся.

# --- Next.js / App ---
# NEXT_PUBLIC_BASE_URL=https://mavita.ru

# --- Database ---
# DATABASE_URL=postgresql://mavita:<password>@localhost:5432/mavita

# --- Robokassa ---
# ROBOKASSA_LOGIN=<merchant login>
# ROBOKASSA_PASSWORD1=<password1 — для формирования подписи при создании платежа>
# ROBOKASSA_PASSWORD2=<password2 — для верификации result URL>
# ROBOKASSA_TEST_MODE=true

# --- Admin ---
# ADMIN_PASSWORD=<пароль для входа в /admin>
# SESSION_SECRET=<32+ случайных символа для iron-session>
